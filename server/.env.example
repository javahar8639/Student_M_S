# PostgreSQL connection string
# Local example: postgresql://postgres:yourpassword@localhost:5432/student_ms
# Render provides this automatically for a managed PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_ms

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=StudentMS <onboarding@resend.dev>

# Used to build password reset links and for CORS in production
FRONTEND_URL=http://localhost:5173
